# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Required. Used only by the server-side route (src/app/api/translate/route.ts);
# never exposed to the browser (do not rename it with a NEXT_PUBLIC_ prefix).
OPENAI_API_KEY=

# Optional. Maximum accepted upload size in bytes (default 524288 = 512 KB).
# MAX_FILE_SIZE_BYTES=524288
