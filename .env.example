# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Required. Used only by the server-side route (src/app/api/translate/route.ts);
# never exposed to the browser (do not rename it with a NEXT_PUBLIC_ prefix).
OPENAI_API_KEY=

# Optional. Maximum accepted upload size in bytes (default 524288 = 512 KB).
# MAX_FILE_SIZE_BYTES=524288

# Optional. Maximum API requests per 60-cue chunk, counting the first request,
# repairs of invalid or missing translations, and retries after temporary
# errors (integer 1-20, default 6).
# MAX_ATTEMPTS_PER_CHUNK=6

# Optional. Prices in USD per 1M tokens of the model you use, for the cost
# estimate shown after a translation and in evaluation runs. No defaults:
# without input and output prices no cost is estimated. Check current
# pricing yourself; the estimate is not a billing limit.
# OPENAI_PRICE_INPUT_PER_MTOK=
# OPENAI_PRICE_CACHED_INPUT_PER_MTOK=
# OPENAI_PRICE_OUTPUT_PER_MTOK=
